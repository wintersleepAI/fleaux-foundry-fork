{"type":"talent","img":"/systems/fleaux/images/system/talents/fetichiste.webp","name":"Fétichiste","system":{"typeName":"Talent","description":"Une de vos armes inflige désormais d12 points de dégâts. Mais un résultat de 1 sur le dé de dégâts signifie qu’elle se brise. Dans ce dernier cas, il vous faut une semaine pour donner cet avantage a une nouvelle arme.","reference":"p. 22"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"E0gf2VLNMstFJC5P":3},"flags":{},"_stats":{"systemId":"fleaux","systemVersion":"2022.3.02","coreVersion":"10.288","createdTime":1667939248316,"modifiedTime":1667939248316,"lastModifiedBy":"E0gf2VLNMstFJC5P"},"_id":"071kgz2pgQzrP6y4"}
