{"type":"talent","img":"/systems/fleaux/images/system/talents/fetichiste.webp","name":"Fétichiste","system":{"typeName":"Talent","description":"Une de vos armes inflige désormais d12 points de dégâts. Mais un résultat de 1 sur le dé de dégâts signifie qu’elle se brise. Dans ce dernier cas, il vous faut une semaine pour donner cet avantage a une nouvelle arme.","reference":"p. 22"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"c5EDQUsVVfPuU8L6":3},"flags":{},"_stats":{"systemId":"fleaux","systemVersion":"2022.3.01","coreVersion":"10.288","createdTime":1666301136244,"modifiedTime":1666301136244,"lastModifiedBy":"c5EDQUsVVfPuU8L6"},"_id":"y6II9xTOOFMjhIoh"}
