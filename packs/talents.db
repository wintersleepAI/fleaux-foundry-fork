{"type":"talent","img":"/systems/fleaux/images/system/talents/rancunier.webp","name":"Rancunier","system":{"typeName":"Talent","description":"Si une attaque vous amène à 0 PV, vous pouvez immédiatement attaquer avec un Avantage avant de vous effondrer.","reference":"p. 23"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0,"E0gf2VLNMstFJC5P":3},"flags":{},"_stats":{"systemId":"fleaux","systemVersion":"2022.3.02","coreVersion":"10.288","createdTime":1667939248359,"modifiedTime":1667939248359,"lastModifiedBy":"E0gf2VLNMstFJC5P"},"_id":"LOgvUM3tK1VuogR4"}
