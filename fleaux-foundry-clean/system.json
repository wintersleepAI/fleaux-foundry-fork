{
	"id": "fleaux",
	"title": "Fléaux!",
	"description": "A role-playing game written by Kobayashi, Art Direction EDgarra Studio",
	"version": "2025.0.0",
	"authors": [
		{
			"name": "Jhenriot alias lemeran81",
			"discord": "lemeran81",
			"email": "lemeran81@free.fr",
			"flags": {
				"urlSuiviTickets": "https://gitlab.com/jhen-javascript/rpg-engine/vtt/foundry/distributions/fleaux/-/boards"
			}
		}
	],
	"compatibility": {
		"minimum": "12",
		"verified": "12",
		"maximum": "12"
	},
	"esmodules": [
		"fleaux.js"
	],
	"scripts": [
		"./scripts/config.js"
	],
	"styles": [
		"./styles/simple.css"
	],
	"packs": [
		{
			"name": "bestiary",
			"label": "The Bestiary",
			"system": "fleaux",
			"path": "./packs/bestiaire.db",
			"type": "Actor"
		},
		{
			"name": "attributes",
			"label": "The Attributes",
			"system": "fleaux",
			"path": "./packs/attributs.db",
			"type": "Item"
		},
		{
			"name": "peoples",
			"label": "The Peoples",
			"system": "fleaux",
			"path": "./packs/peuples.db",
			"type": "Item"
		},
		{
			"name": "crimes",
			"label": "The Crimes",
			"system": "fleaux",
			"path": "./packs/crimes.db",
			"type": "Item"
		},
		{
			"name": "professions",
			"label": "The Professions",
			"system": "fleaux",
			"path": "./packs/professions.db",
			"type": "Item"
		},
		{
			"name": "equipment",
			"label": "The Equipment",
			"system": "fleaux",
			"path": "./packs/equipements.db",
			"type": "Item"
		},
		{
			"name": "talents",
			"label": "The Talents",
			"system": "fleaux",
			"path": "./packs/talents.db",
			"type": "Item"
		},
		{
			"name": "spells",
			"label": "The Spells",
			"system": "fleaux",
			"path": "./packs/sorts.db",
			"type": "Item"
		},
		{
			"name": "tables",
			"label": "The Tables",
			"system": "fleaux",
			"path": "./packs/tables.db",
			"type": "RollTable"
		},
		{
			"name": "scenes",
			"label": "The Scenes",
			"system": "fleaux",
			"path": "./packs/scenes.db",
			"type": "Scene"
		}
	],
	"languages": [
		{
			"lang": "fr",
			"name": "French",
			"path": "./lang/fr.json"
		},
		{
			"lang": "en",
			"name": "English",
			"path": "./lang/en.json"
		}
	],
	"relationships": {
		"requires": [
			{
				"id": "socketlib",
				"type": "module",
				"manifest": "https://raw.githubusercontent.com/manuelVo/foundryvtt-socketlib/master/module.json",
				"compatibility": {
					"verified": "1.0.13"
				}
			}
		]
	},
	"socket": true,
	"grid": {
		"distance": 5,
		"units": "mt"
	},
	"primaryTokenAttribute": "attributes.pv",
	"secondaryTokenAttribute": "",
	"background": "systems/fleaux/images/ui/fond.png",
	"url": "https://gitlab.com/jhen-javascript/rpg-engine/vtt/foundry/distributions/fleaux",
