<form class="{{cssClass}}" autocomplete="off" style="height: 250px;">
	{{> (itemPartial "item-header") }}
	<div class="form-group stacked">
		<div class="form-fields">
			<!-- Catégorie -->
			<label>Catégorie</label>
			<select name="system.categorie" value="item.system.categorie">
				{{#select item.system.categorie}}
				<option value="arme">{{localize 'Arme'}}</option>
				<option value="armure">{{localize 'Armure'}}</option>
				<option value="objet">{{localize 'Objet'}}</option>
				<option value="service">{{localize 'Service'}}</option>
				{{/select}}
			</select>
			<!-- Type de prix -->
			<label>Type de prix</label>
			<select name="system.formulePrix" value="item.system.formulePrix">
				{{#select item.system.formulePrix}}
				<option value="d6">{{localize 'Prix normal'}}</option>
				<option value="d6*10">{{localize 'Prix moyen'}}</option>
				<option value="d6*100">{{localize 'Prix fort'}}</option>
				{{/select}}
			</select>
		</div>
	</div>
	<div class="form-group stacked">
		<div class="form-fields">
			<!-- Type d'attaque -->
			<label>Type d'attaque</label>
			<select name="system.typeAttaque" value="item.system.typeAttaque">
				{{#select item.system.typeAttaque}}
				<option value="melee">{{localize 'Mêlée'}}</option>
				<option value="tir">{{localize 'Tir'}}</option>
				<option value="melee-tir">{{localize 'Les deux'}}</option>
				{{/select}}
			</select>
			<!-- Arme à deux mains -->
			<label class="checkbox">
				<input type="checkbox" name="system.deuxMains" {{checked item.system.deuxMains}}> {{localize "Armes à deux mains"}}
			</label>
		</div>
	</div>

	<div class="form-group stacked">
		<div class="form-fields">
			<!-- Protection -->			
			<label>Protection</label>
			<select name="system.protection" value="item.system.protection">
				{{#select item.system.protection}}
				<option value="PR1">Protection 1</option>
				<option value="PR2">Protection 2</option>
				{{/select}}
			</select>
		</div>
	</div>
	<br>
	<!-- Dés d'usure de l'équipement -->
    {{> (communPartial "des-usage")  data = item.system.de-usure  
									 data-str = "system.de-usure"
									 afficher-de-actuel = true
									 afficher-de-max = true
									 affichage-ligne = true
									 label = "Dés d'usure"
									 de-usage = "de-usage-equipement"}}
	<br>
	<!-- l'enchantement d'objet-->
	<div class="form-group stacked">
		<!-- enchanté ?-->
		<label class="checkbox"
			title="Un personnage ne devrait pas posséder plus d’un objet de ce type. En fait nous vous conseillons même de vous limiter à un maximum de deux objets par groupe.">
			<input type="checkbox" name="system.enchantement.enchante" {{checked item.system.enchantement.enchante}}> {{localize "L'équipement est enchanté"}}
		</label>
		<!-- enchantement des armes -->
		<div class="form-group stacked" style="display:{{#if item.system.enchantement.enchante}}{{else}}none{{/if}};">
			<div class="form-fields">
				<!-- arme tueuse ?-->
				<label class="checkbox"
					title="Ce type d’arme inflige des dégâts maximum lors d’une attaque réussie contre sa cible de prédilection (vampires, sangrelins, morts-vivants, etc.).">
					<input type="checkbox" name="system.enchantement.arme.tueuse" {{checked item.system.enchantement.arme.tueuse}}> {{localize "Arme tueuse"}}
				</label>
				<!-- arme en acier ilmarien ?-->
				<label class="checkbox"
					title="L’acier ilmarien est le matériau le plus résistant que l’on puisse trouver. Le secret de sa fabrication s’est malheureusement perdu et les armes faites de cet acier sont rarissimes et leur valeur est inestimable. Une arme en acier ilmarien inflige 1 point de dégâts supplémentaire.">
					<input type="checkbox" name="system.enchantement.arme.acierIlmarien" {{checked item.system.enchantement.arme.acierIlmarien}}>{{localize "Arme en acier Ilmarien"}}
				</label>
			</div>
		</div>
		<br>
		<!-- enchantement des objets -->
		<div class="form-group stacked" style="display:{{#if item.system.enchantement.enchante}}{{else}}none{{/if}};">
			<div class="form-fields">
				<!-- avantage ? -->
				<label class="checkbox"
					title="Un objet de ce genre peut accorder un Avantage à un type d’action précis, comme une cape de dissimulation qui accorde un Avantage à tout jet de Dextérité dédié à la discrétion.">
					<input type="checkbox" name="system.enchantement.objet.avantage" {{checked item.system.enchantement.objet.avantage}}> {{localize "Accorde un Avantage"}}
				</label>
				<select name="system.enchantement.objet.attributCode" style="display: {{#if item.system.enchantement.objet.avantage}}{{else}}none{{/if}};">
					{{#select item.system.enchantement.objet.attributCode}}
					{{#each ./attributs as |attribut|}}
					<option value="{{attribut.system.code}}">{{localize 'FLEAUX.libelle.en'}} {{localize attribut.name}}</option>
					{{/each}}
					{{/select}}
				</select>
			</div>
			<!-- sortilège -->			
			<div class="form-fields">
				<label class="checkbox"
					title="Un objet de ce genre peut accorder l’effet d’un sort (dans ce cas l’objet possède un d6 d'utilisation).">
					<input type="checkbox" name="system.enchantement.objet.effetSort" {{checked item.system.enchantement.objet.effetSort}}> {{localize "Accorde un effet de sort"}}
				</label>
				<select name="system.enchantement.objet.sort.id" style="display: {{#if item.system.enchantement.objet.effetSort}}{{else}}none{{/if}};">
					{{#select item.system.enchantement.objet.sort.id}}
					{{#each ./sorts as |sort|}}
					<option value="{{sort._id}}" title="{{localize sort.system.description}}" >{{localize sort.name}}</option>
					{{/each}}
					{{/select}}
				</select>
				<!-- Dés d'usure de l'équipement -->
				<span style="display: {{#if item.system.enchantement.objet.effetSort}}{{else}}none{{/if}};">
					{{> (communPartial "des-usage")  data = item.system.enchantement.objet.sort.de-usure 
													 data-str = "system.enchantement.objet.sort.de-usure" 
													 afficher-de-actuel = true 
													 afficher-de-max = true 
													 affichage-ligne = true
													 label = "Dés d'usage"
													 de-usage = "de-usage-sort"}}
				</span>
			</div>
		</div>
	</div>
	{{> (communPartial "editor-box") libelle= "DESCRIPTION" data = item.system.description data-str = "system.description"}}
</form>