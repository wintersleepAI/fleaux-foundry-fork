<form class="{{cssClass}}" autocomplete="off">
    {{> (itemPartial "item-header")}}
    {{!-- Professions --}}
    <div class="form-group flexrow">
        <h4 class="repeater-entete">
            {{localize "PROFESSION.libelle.pour-survivre"}}
            <a class="repeater-bouton ajouter-profession"><i class="fas fa-plus"></i></a>
        </h4>
        <ol class="repeater form-group">
            {{#each item.system.professions as |profession i| }}
            <li class="repeater flexrow" data-repeater="{{i}}">
                <div style="display: flex; flex-wrap: nowrap; flex-direction: column;">
                    <div style="display: flex; flex-wrap: nowrap;">
                        <input style="flex: 0 0 2%; border: none;" type="number" name="system.professions.{{i}}.0" value="{{lookup this '0'}}" readonly />
                        <input style="flex: 0 0 30%; font-weight: bolder;" aria-multiline="true" type="text" name="system.professions.{{i}}.1" value="{{lookup this '1'}}" />
                        <div style="flex: 1 0 2%; color: grey;"></div>+
                        <input style="flex: 0 0 2%;" type="number" name="system.professions.{{i}}.3" value="{{lookup this '3'}}" />
                        <select style="flex: 0 0 30%;" name="system.professions.{{i}}.4">
                            {{#select (lookup this "4")}}
                            <option value=""/>
                            {{#each ../attributs as |attribut|}}
                            <option value="{{localize attribut.system.code}}">{{localize 'FLEAUX.libelle.en'}}{{localize attribut.name}}</option>
                            {{/each}}
                            {{/select}}
                        </select>
                    </div>
                    <div style="display: flex; flex-wrap: nowrap;">
                        <textarea style= "border: none;" type="text" name="system.professions.{{i}}.2" value="{{lookup this '2'}}" >{{lookup this '2'}}</textarea>
                    </div>
                </div>
                <a class="repeater-bouton enlever-profession"><i class="fas fa-minus"></i></a>
            </li>
            {{/each}}
        </ol>
    </div>
</form>