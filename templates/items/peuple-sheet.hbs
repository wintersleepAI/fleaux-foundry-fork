<form class="{{cssClass}}" autocomplete="off">
    {{> (itemPartial "item-header")}}
    {{!-- Educations --}}
    <div class="form-group flexrow">
        <h4 class="repeater-entete">
            {{localize "PEUPLE.libelle.vous-avez-grandi"}}
            <a class="repeater-bouton ajouter-education"><i class="fas fa-plus"></i></a>
        </h4>
        <ol class="repeater form-group">
            {{#each item.system.educations as |education i| }}
            <li class="repeater flexrow" data-repeater="{{i}}">
                <input style="flex: 0 0 22px;" type="number" name="system.educations.{{i}}.0" value="{{lookup this '0'}}" readonly />
                <input style="flex: 0 0 390px;" type="text" name="system.educations.{{i}}.1" value="{{lookup this '1'}}" />
                <input style="flex: 0 0 22px;" type="number" name="system.educations.{{i}}.2" value="{{lookup this '2'}}" />
                <select name="system.educations.{{i}}.3">
                    {{#select (lookup this "3")}}
                    {{#each ../attributs as |attribut|}}
                    <option value="{{localize attribut.system.code}}">{{localize 'FLEAUX.libelle.en'}}{{localize attribut.name}}</option>
                    {{/each}}
                    <option value="{{localize "MELTIR"}}">{{localize 'PEUPLE.libelle.melee-ou-Tir'}}</option>
                    <option value="{{localize "AUCHOIX"}}">{{localize 'PEUPLE.libelle.choisir-attribut'}}</option>
                    {{/select}}
                </select>
                <a class="repeater-bouton enlever-education"><i class="fas fa-minus"></i></a>
            </li>
            {{/each}}
        </ol>    
    </div>
</form>
