<header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <div class="header-fields flexrow">
        <h1 class="charname">
            <input name="name" type="text" value="{{item.name}}" placeholder="Name"/>
            <input style="font-style: italic; font-size: initial; color: black;" name="system.reference" type="text" value="{{item.system.reference}}" data-dtype="String"}}/> 
        </h1>
        <div class="item-subtitle">
            <h4 class="item-type">{{localize item.system.typeName}}</h4>
        </div>
    </div>
</header>

