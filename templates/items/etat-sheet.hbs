<form class="{{cssClass}}" autocomplete="off" style="height: 250px;">
	{{> (itemPartial "item-header")}}
	<!-- date et acteur d'origine -->
	<div class="information">
		<span class="info-label">{{item.system.date}}</span>&nbsp;&nbsp;
		<span class="info-input">Acteur.{{item.actor.id}}</span>
	</div>
	<!-- type d'état-->
	<div class="form-fields" style="display: grid;">
		<label>{{localize "Type de l'état"}}</label>
		<select name="system.typeDuree">
			{{#select item.system.typeDuree}}
			<option value="permanent">{{localize "Permanent"}}</option>
			<option value="par-partie">{{localize "Par partie"}}</option>
			<option value="par-scene">{{localize "Par scène"}}</option>
			<option value="par-combat">{{localize "Par combat"}}</option>
			<option value="par-tour">{{localize "Par tour"}}</option>
			{{/select}}
		</select>
	</div>
	<br>
    {{> (itemPartial "item-macro")}}
	{{> (communPartial "editor-box") libelle= "DESCRIPTION" data = item.system.description data-str="system.description"}}
</form>