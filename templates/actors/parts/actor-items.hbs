<ol class="items-box expanded">
	<li class="items-header">
		{{#each headers as |header|}}
			<div style="{{header.style}}">{{localize header.name}}</div>
		{{/each}}
		<div class="item-controls" style="flex: 1; text-align: left;">
			<a class="item-control item-create" data-type="{{data-type}}" data-categorie="{{data-categorie}}">
				<i class="fas fa-plus"></i>&nbsp;{{localize 'Créer'}}&nbsp;&nbsp;
			</a>
		</div>
	</li>
	{{#each items}}
		<li class="items-list" data-item-id="{{_id}}">
			<div class="item-image" style="{{../headers.0.style}}">
				<img src="{{img}}" style="background-color: black;" width="24" height="24"/>
				<span style="cursor: pointer;">&nbsp;&nbsp;{{name}}</span>
			</div>
			{{#if ../data-categorie}}
				{{>(itemsActorPartial ../data-categorie) item=this headers=../headers }}
			{{/if}} 
			<div class="item-controls" style="flex: 1; text-align: center;">
				{{#if (etatEstModifiable system.macroScript.parent.modifiable) }}<a class="item-control item-edit" data-tooltip="{{localize "Editer"}}"><i class="fas fa-edit"></i></a>{{/if}}
				{{#if (etatEstsupprimable system.macroScript.parent.supprimable) }}<a class="item-control item-delete" data-tooltip="{{localize "Supprimer"}}"><i class="fas fa-trash"></i></a>{{/if}}
			</div>
		</li>
	{{/each}}
</ol>
